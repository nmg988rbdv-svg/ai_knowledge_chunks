OPENAI_API_KEY=replace-with-your-api-key
OPENAI_MODEL=gpt-5.2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HTTP_ADDR=:8080
LLM_TIMEOUT=30s

MILVUS_ADDRESS=127.0.0.1:29530
MILVUS_API_KEY=root:Milvus
MILVUS_COLLECTION=ai_knowledge_chunks
# text-embedding-3-small 默认返回 1536 维。
MILVUS_DIMENSION=1536
MILVUS_HOST_PORT=29530
MILVUS_WEBUI_PORT=19091
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001

REDIS_ADDRESS=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DATABASE=0

KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=knowledge.ingest.v1
KAFKA_GROUP=ai-knowledge-workers

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
JOB_TTL=24h
CONVERSATION_TTL=24h
